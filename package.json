{
  "name": "lpc-spritesheet-mcp",
  "version": "1.2.0",
  "description": "MCP server that generates Universal LPC character spritesheets headlessly (no browser) from the LiberatedPixelCup asset pack: 657 items, 6 body types, palette recoloring, 15 standard animations plus oversize custom ones",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "spritesheet",
    "sprite",
    "pixel-art",
    "lpc",
    "liberated-pixel-cup",
    "game-assets",
    "character-generator",
    "gamedev"
  ],
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "lpc-spritesheet-mcp": "./src/index.js",
    "lpc-spritesheet-setup": "./scripts/setup-assets.mjs"
  },
  "files": [
    "src",
    "scripts/setup-assets.mjs",
    "docs/*.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/index.js",
    "setup-assets": "node scripts/setup-assets.mjs",
    "showcase": "node scripts/make-showcase.mjs",
    "diagrams": "node scripts/make-architecture-svg.mjs",
    "demo": "node scripts/make-demo-gif.mjs",
    "assets": "npm run diagrams && npm run showcase && npm run demo",
    "test": "node --test test/run-tests.mjs test/mcp-client-test.mjs test/smoke-canvas.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanishka-namdeo/lpc-spritesheet-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/kanishka-namdeo/lpc-spritesheet-mcp/issues"
  },
  "homepage": "https://github.com/kanishka-namdeo/lpc-spritesheet-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@napi-rs/canvas": "^0.1.80"
  },
  "devDependencies": {
    "gifenc": "^1.0.3"
  }
}
